{
  "name": "animal-dash-server",
  "version": "1.0.0",
  "private": true,
  "description": "ANIMAL DASH: ULTIMATE RACE - authoritative Colyseus game server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --packages=external --tsconfig=tsconfig.json --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:sim": "tsx src/tests/simTest.ts",
    "test:net": "tsx src/tests/netTest.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.16.26",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "colyseus.js": "0.16.22",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
